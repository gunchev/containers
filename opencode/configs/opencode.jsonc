// Sample ~/.config/opencode/opencode.jsonc configuration file (JSON + comments = jsonc)

{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": { "baseURL": "http://127.0.0.1:7626/v1" },
      "models": {
        "Ornith-35B-BF16":                 { "name": "Ornith-35B-BF16"                 }, // Context: 262K, text only
        "Ornith-35B":                      { "name": "Ornith-35B"                      }, // Context: 262K, text only
        "Ornith-35B-UD-Q8_K_XL":           { "name": "Ornith-35B-UD-Q8_K_XL"           }, // Context: 262K, text only
        "Qwen3.6-27B-DFlash-Q8_0":         { "name": "Qwen3.6-27B-DFlash-Q8_0"         }, // Context: 262K, text+image
        "gemma-4-31B-it":                  { "name": "gemma-4-31B-it"                  }, // Context: 262K, text+image
        "Gemma-26B":                       { "name": "Gemma-26B"                       }, // Context: 262K, text only
        "Gemma-12B":                       { "name": "Gemma-12B"                       }, // Context: 262K, text only
        "Gemma-E4B":                       { "name": "Gemma-E4B"                       }, // Context: 131K, text only
        "Gemma-E2B":                       { "name": "Gemma-E2B"                       }  // Context: 131K, text only
      }
    }
  }
}
