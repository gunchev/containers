FROM registry.fedoraproject.org/fedora:44 as fedora_updated

ARG VERSION

# We want the latest versions.
# hadolint ignore=DL3041

RUN printf "\n\n# Added during image build\n" >> /etc/dnf/dnf.conf \
    && printf "minrate=100\ntimeout=60\nmax_parallel_downloads=8\nfastestmirror=True\n" >> /etc/dnf/dnf.conf \
    && printf "assumeyes=True\nkeepcache=1\nnodocs=True\ninstall_weak_deps=False\n" >> /etc/dnf/dnf.conf

RUN --mount=type=cache,dst=/var/cache/libdnf5/ --mount=type=tmpfs,dst=/var/log --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/var/tmp \
    dnf makecache && \
    dnf update && \
    rpm --setcaps shadow-utils && \
    dnf install \
        podman podman-compose podman-docker fuse-overlayfs containernetworking-plugins buildah skopeo openssh-clients cpp sqlite \
        which curl git zip unzip nnn mc vim-enhanced pico nano \
        findutils gawk jq sed util-linux \
        cmake clang-tools-extra shellcheck whiptail python3-pylint python3-autopep8 make \
        glow nodejs npm fuser tar pv coreutils openssh-clients nmap-ncat \
        shfmt black uv ruff python3-isort python3-fixit \
        yamllint hadolint python3-ansible-lint csslint rpmlint gitlint \
        ripgrep fzf bat fd-find jq gojq parallel \
        golang rust java-latest-openjdk-devel rust-analyzer \
        ninja-build gcc gcc-c++ gdb cppcheck dpkg mock rpmdevtools \
    && rm -fv /etc/machine-id /var/lib/systemd/random-seed

COPY /containers.conf /etc/containers/containers.conf

# Copy & modify the defaults to provide reference if runtime changes needed.
# Changes here are required for running with fuse-overlay storage inside container.
RUN sed -e 's|^#mount_program|mount_program|g' \
           -e '/additionalimage.*/a "/var/lib/shared",' \
           -e 's|^mountopt[[:space:]]*=.*$|mountopt = "nodev,fsync=0"|g' \
           /usr/share/containers/storage.conf \
           > /etc/containers/storage.conf

# Setup internal Podman to pass subscriptions down from host to internal container
RUN printf '/run/secrets/etc-pki-entitlement:/run/secrets/etc-pki-entitlement\n/run/secrets/rhsm:/run/secrets/rhsm\n' > /etc/containers/mounts.conf \
    && touch /etc/machine-id

# Note VOLUME options must always happen after the chown call above
# RUN commands can not modify existing volumes
VOLUME /var/lib/containers

ENV _CONTAINERS_USERNS_CONFIGURED="" \
    BUILDAH_ISOLATION=chroot


# Install opencode
ARG VERSION
RUN ARCH=$(uname -m) && \
    if [[ "$ARCH" == "aarch64" ]]; then \
        ARCH="arm64"; \
    elif [[ "$ARCH" == "x86_64" ]]; then \
        ARCH="x64"; \
    fi && \
    FILENAME="opencode-linux-${ARCH}.tar.gz" && \
    if [[ -n "${VERSION}" ]]; then \
        URL="https://github.com/sst/opencode/releases/download/v${VERSION}/${FILENAME}"; \
    else \
        URL="https://github.com/sst/opencode/releases/latest/download/${FILENAME}"; \
    fi && \
    cd /tmp && \
    curl -fsSL -o "${FILENAME}" "${URL}" && \
    tar -xvf "${FILENAME}" && \
    mv opencode "/usr/local/bin/" && \
    chmod 755 "/usr/local/bin/opencode" && \
    rm -f "${FILENAME}"


# OCI image labels so this image is identifiable in registries and `podman inspect`.
# Overrides the upstream-fed `org.opencontainers.image.title=fedora`.
LABEL org.opencontainers.image.title="opencode" \
      org.opencontainers.image.description="OpenCode (sst/opencode) AI coding agent on Fedora 44 with full toolchain" \
      org.opencontainers.image.source="https://github.com/gunchev/containers/tree/master/opencode" \
      org.opencontainers.image.url="https://github.com/gunchev/containers/tree/master/opencode" \
      org.opencontainers.image.documentation="https://opencode.ai/" \
      org.opencontainers.image.vendor="dgunchev" \
      org.opencontainers.image.licenses="Unlicense" \
      org.opencontainers.image.authors="dgunchev"


# Create the in-container `podman` user so `make test` (and the helper
# scripts' `--userns=keep-id`) can pass `--user podman` reliably.
# Avoid UID 1000 because `toolbox init-container` will try to useradd the
# host's first user (typically uid 1000) and fail with
# "UID 1000 is not unique". UID 2000 is the next-sensible convention.
RUN getent group podman >/dev/null || groupadd -g 2000 podman \
    && useradd -m -d /home/podman -u 2000 -g podman -s /bin/bash podman \
    && mkdir -p /run/user/2000 \
    && chown -R podman:podman /run/user/2000 /var/lib/containers /home/podman

USER podman
WORKDIR /home/podman

CMD ["/usr/bin/bash"]
